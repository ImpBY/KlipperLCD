# Service environment for KlipperLCD
# These variables are consumed by the application at startup.

# UART serial device for LCD panel
KLIPPERLCD_LCD_PORT=/dev/ttyAMA0
KLIPPERLCD_LCD_BAUDRATE=115200

# Klippy socket path
KLIPPERLCD_KLIPPY_SOCK=/home/pi/printer_data/comms/klippy.sock

# Moonraker URL/API placeholders
KLIPPERLCD_MOONRAKER_URL=127.0.0.1
KLIPPERLCD_MOONRAKER_PORT=80
KLIPPERLCD_API_KEY=XXXXXX

# LCD refresh/update interval (seconds)
KLIPPERLCD_UPDATE_INTERVAL=2

# Klipper filament sensor name (SET_FILAMENT_SENSOR SENSOR=<name>)
KLIPPERLCD_FILAMENT_SENSOR_NAME=filament_runout_sensor

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KLIPPERLCD_LOG_LEVEL=INFO

# HMI interaction trace: set to 1 to record every screen touch input and
# the commands it triggers (LCD writes, events, gcode/REST/klippy calls)
# into a standalone file, independent of KLIPPERLCD_LOG_LEVEL.
KLIPPERLCD_HMI_TRACE=0
# KLIPPERLCD_HMI_TRACE_FILE=/home/pi/printer_data/logs/KlipperLCD_hmi_trace.log
